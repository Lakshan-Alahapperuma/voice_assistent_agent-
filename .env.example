# Nova Agent Configuration

# Ollama Model Name (e.g. qwen2.5:3b, qwen2.5:7b, llama3.1:8b, qwen3:4b)
NOVA_MODEL=qwen2.5:3b

# Ollama API Host
OLLAMA_HOST=http://127.0.0.1:11434

# macOS Text-to-Speech Voice (e.g. Samantha, Alex, Ava, Daniel, Karen, Victoria)
NOVA_VOICE=Samantha
NOVA_SPEECH_RATE=190

# Safe Base Directories (comma separated, defaults to User Home)
# NOVA_ALLOWED_PATHS=/Users/username,/Users/username/Desktop,/Users/username/Documents,/Users/username/Downloads

# Auto-confirm non-destructive actions (True/False)
NOVA_AUTO_CONFIRM_SAFE=True

# Email Integration (Optional - Apple Mail works natively via AppleScript)
# GMAIL_CLIENT_SECRET_FILE=credentials.json
